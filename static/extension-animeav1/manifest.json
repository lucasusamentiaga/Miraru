{
  "manifest_version": 3,
  "name": "Miraru — episodios vistos",
  "short_name": "Miraru",
  "version": "1.5.1",
  "description": "Lo que ves en AnimeAV1, Netflix y Crunchyroll se apunta solo en tu Miraru. Tus listas de AnimeAV1 también.",
  "icons": {
    "16": "iconos/16.png",
    "32": "iconos/32.png",
    "48": "iconos/48.png",
    "128": "iconos/128.png"
  },
  "action": {
    "default_title": "Miraru",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "iconos/16.png",
      "32": "iconos/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "webRequest",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.animeav1.com/*",
    "https://www.netflix.com/*",
    "https://www.crunchyroll.com/*",
    "https://static.crunchyroll.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "streaming.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://static.crunchyroll.com/*"
      ],
      "js": [
        "streaming.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
