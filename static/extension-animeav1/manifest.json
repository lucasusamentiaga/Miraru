{
  "manifest_version": 3,
  "name": "Miraru — episodios vistos",
  "short_name": "Miraru",
  "version": "1.9.0",
  "description": "Lo que ves en AnimeAV1, AnimeFLV, Netflix y Crunchyroll se apunta en tu Miraru. En AnimeAV1 salta openings y sigue solo.",
  "icons": {
    "16": "iconos/16.png",
    "32": "iconos/32.png",
    "48": "iconos/48.png",
    "128": "iconos/128.png"
  },
  "action": {
    "default_title": "Miraru",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "iconos/16.png",
      "32": "iconos/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "webRequest",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.animeav1.com/*",
    "https://www.netflix.com/*",
    "https://www.crunchyroll.com/*",
    "https://static.crunchyroll.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "streaming.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://static.crunchyroll.com/*"
      ],
      "js": [
        "streaming.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.animeflv.net/ver/*",
        "https://animeflv.net/ver/*",
        "https://animeflv.or.at/*",
        "https://*.animeflv.or.at/*"
      ],
      "js": [
        "i18n.js",
        "animeflv.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://animeav1.com/*"
      ],
      "js": [
        "i18n.js",
        "animeav1-player.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://zilla-networks.com/*",
        "https://*.zilla-networks.com/*",
        "https://uns.bio/*",
        "https://*.uns.bio/*",
        "https://turboembed.com/*",
        "https://*.turboembed.com/*",
        "https://voe.sx/*",
        "https://*.voe.sx/*",
        "https://byselapuix.com/*",
        "https://*.byselapuix.com/*",
        "https://n1mwq.org/*",
        "https://*.n1mwq.org/*",
        "https://yourupload.com/*",
        "https://*.yourupload.com/*",
        "https://mp4upload.com/*",
        "https://*.mp4upload.com/*",
        "https://ryderjet.com/*",
        "https://*.ryderjet.com/*",
        "https://callistanise.com/*",
        "https://*.callistanise.com/*",
        "https://streamtape.com/*",
        "https://*.streamtape.com/*"
      ],
      "js": [
        "reproductor.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "iconos/48.png"
      ],
      "matches": [
        "https://*.animeflv.net/*",
        "https://*.animeflv.or.at/*",
        "https://animeav1.com/*",
        "https://animeflv.net/*",
        "https://animeflv.or.at/*"
      ]
    }
  ]
}
